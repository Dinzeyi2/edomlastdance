# Auth: the single bearer token Lovable's server function sends as
# `Authorization: Bearer <this>`. Set your own random value in real
# deployments -- the default below is fine for local dev only.
RAILWAY_API_KEY=dev-local-key

# DB + queue. Defaults to a local SQLite file and eager (inline) Celery
# execution, so the whole pipeline runs with zero external infra. Point
# DATABASE_URL at Postgres and unset CELERY_TASK_ALWAYS_EAGER for anything
# resembling production -- see README "Local development" vs "Deploy to
# Railway".
DATABASE_URL=sqlite:///./roofai.db
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Providers. "mock"/"center_crop"/"rule_based"/"none"/"local" are all real,
# working, zero-API-key defaults -- see each app/services/*.py module
# docstring for exactly what's real vs. a stub waiting on a real vendor.
IMAGERY_PROVIDER=mock          # mock | google_solar | nearmap
FOOTPRINT_PROVIDER=center_crop # center_crop | osm | sam2
DEFECT_PROVIDER=rule_based     # rule_based | yolo
LLM_PROVIDER=none              # none | openai
STORAGE_PROVIDER=local         # local | s3

# Provider credentials -- only read by the matching provider above.
GOOGLE_SOLAR_API_KEY=
NEARMAP_API_KEY=
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-4o-mini
YOLO_MODEL_PATH=

# Storage (STORAGE_PROVIDER=s3). Works with AWS S3 or any S3-compatible
# endpoint -- set S3_ENDPOINT for Cloudflare R2 (no egress fees).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=roofai
S3_REGION=auto
LOCAL_STORAGE_DIR=./storage

# Optional webhook push to Lovable on job completion (in addition to
# Lovable polling GET /jobs/{id}). Leave LOVABLE_WEBHOOK_URL blank to skip it.
LOVABLE_WEBHOOK_URL=
WEBHOOK_SECRET=dev-webhook-secret
