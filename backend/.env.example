# Database. Defaults to a local SQLite file so the whole pipeline runs with
# zero external infra. Point this at a real Postgres instance for production
# (no PostGIS extension required -- geo filtering is done in application code
# via Shapely, see app/pipeline/geo.py).
DATABASE_URL=sqlite+aiosqlite:///./roofing.db

# Data source providers. "mock" implementations are the default and generate
# deterministic synthetic data so the pipeline runs without any API keys.
# Swap to a real provider name once that integration is implemented.
STORM_PROVIDER=mock
PROPERTY_PROVIDER=mock
IMAGERY_PROVIDER=mock

# Vision/damage-detection provider. "stub" is deterministic and free.
# Set to "claude" to run real LLM vision inference against the (mock or real)
# imagery -- requires ANTHROPIC_API_KEY.
VISION_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Comma-separated seed API keys for local dev tenants (see app/core/seed.py).
# Not used in production -- create tenants via the API/DB instead.
DEV_SEED_TENANT_KEY=dev-local-key
