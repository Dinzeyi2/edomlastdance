# GPU worker image for FOOTPRINT_PROVIDER=sam2. Separate from the main
# Dockerfile (API + default CPU worker) on purpose: torch + a GPU base image
# are multi-GB and irrelevant to every other service, and pairing torch with
# the wrong CUDA build is a common source of broken installs -- using the
# official `pytorch/pytorch` CUDA image sidesteps that instead of building
# torch's CUDA wheel selection by hand.
#
# Build context is still the REPO ROOT (matches the main Dockerfile and
# /railway.json's convention) -- see backend/README.md's "Deploy to Railway"
# section for why. Build with:
#   docker build -f backend/Dockerfile.worker \
#     --build-arg SAM2_CHECKPOINT_URL=<url from facebookresearch/sam2's README> \
#     -t roofai-gpu-worker .
#
# SAM2_CHECKPOINT_URL: copy the CURRENT correct URL from
# https://github.com/facebookresearch/sam2#model-checkpoints yourself --
# this sandbox could not reach dl.fbaipublicfiles.com to verify one, and a
# guessed/hardcoded URL risks silently going stale.
#
# Base image tag confirmed to actually exist via Docker Hub's registry API
# (checked directly, not assumed) and picked to satisfy Meta's real sam2
# package requirement of torch>=2.5.1 (confirmed by inspecting sam2's actual
# setup.py -- see requirements-gpu.txt's comments for why that matters: the
# PyPI package named "sam2" is NOT the official one).
FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime

WORKDIR /app

COPY backend/requirements.txt backend/requirements-gpu.txt ./
# sam2's own setup.py optionally builds a CUDA extension for a post-processing
# step (hole-filling refinement) -- that build needs nvcc, which this
# `-runtime` base image tag doesn't have (only `-devel` tags do). Their build
# script tolerates this (SAM2_BUILD_ALLOW_ERRORS defaults to true -- it warns
# and continues, doesn't fail the install), so core segmentation inference
# still works without it. If you want that extension for better mask quality,
# switch the FROM line above to a `-devel` tag instead (larger image).
RUN pip install --no-cache-dir -r requirements.txt -r requirements-gpu.txt

COPY backend/app ./app

ARG SAM2_CHECKPOINT_URL
RUN mkdir -p /models && \
    if [ -n "$SAM2_CHECKPOINT_URL" ]; then \
        pip install --no-cache-dir requests && \
        python -c "import requests,shutil; r=requests.get('$SAM2_CHECKPOINT_URL', stream=True); r.raise_for_status(); shutil.copyfileobj(r.raw, open('/models/sam2_checkpoint.pt','wb'))"; \
    else \
        echo "SAM2_CHECKPOINT_URL not set at build time -- mount/download the checkpoint at runtime instead and point SAM2_CHECKPOINT_PATH at it." ; \
    fi

ENV SAM2_CHECKPOINT_PATH=/models/sam2_checkpoint.pt
ENV SAM2_DEVICE=cuda
ENV FOOTPRINT_PROVIDER=sam2

# This is a worker, not the API -- no port to expose. Concurrency=1: one
# GPU, one model instance loaded per process (see Sam2FootprintProvider's
# class-level model cache in app/services/footprint.py) -- don't raise this
# without also reworking that cache into a per-worker-process singleton
# that's safe for multiple prefork children.
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info", "--concurrency=1"]
